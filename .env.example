# NEPSE API Configuration
NEPSE_API_URL=https://nepalstock.com/api/nots/nepse-data/today-price
NEPSE_AUTH_TOKEN=your_token_here

# Database Configuration
DATABASE_URL=sqlite:///./nepse.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/nepse_db

# Data Collection
DATA_FETCH_INTERVAL=300
RETRY_ATTEMPTS=3
RETRY_DELAY=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model Training
EPOCHS=50
BATCH_SIZE=32
LEARNING_RATE=0.001
VALIDATION_SPLIT=0.1

# Prediction
CONFIDENCE_THRESHOLD=0.7
PREDICTION_DAYS_AHEAD=1
