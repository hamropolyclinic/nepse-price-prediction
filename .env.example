# NEPSE API Configuration
NEPSE_API_URL=https://nepalstock.com/api/nots/nepse-data/today-price
NEPSE_AUTH_TOKEN=your_token_here

# Database Configuration
DATABASE_URL=sqlite:///./nepse_data.db
# For PostgreSQL: postgresql://user:password@localhost/nepse_db

# Data Collection Settings
DATA_FETCH_INTERVAL=300  # seconds (5 minutes)
RETRY_ATTEMPTS=3
RETRY_DELAY=5  # seconds

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/nepse_collector.log

# Historical Data
START_DATE=2021-01-01
END_DATE=2024-12-31
